projection;
strict ( 2 );
use draft;

define behavior for YC_PUR_ORD_HDR_A //alias <alias_name>
{
  use create;
  use update;
  use delete;

  use action Edit;
  use action Activate;
  use action Discard;
  use action Resume;
  use action Prepare;
  use association _Item { create; with draft; }
}

define behavior for YC_PUR_ORD_ITEM_A //alias <alias_name>
{
  use update;
  use delete;

  use association _Header { with draft; }
}